rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== Helper Functions ====================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return getUserData().role;
    }
    
    // Role Checks
    function isStudent() {
      return isSignedIn() && getUserRole() == 'student';
    }
    
    function isTeacher() {
      return isSignedIn() && getUserRole() == 'teacher';
    }
    
    function isParent() {
      return isSignedIn() && getUserRole() == 'parent';
    }
    
    function isSchoolAdmin() {
      return isSignedIn() && getUserRole() == 'school_admin';
    }
    
    function isESAAdmin() {
      return isSignedIn() && getUserRole() == 'esa_admin';
    }
    
    function isMinistryAdmin() {
      return isSignedIn() && getUserRole() == 'ministry_admin';
    }
    
    function isAnyAdmin() {
      return isSchoolAdmin() || isESAAdmin() || isMinistryAdmin();
    }
    
    // Organization Checks
    function isSameSchool(schoolId) {
      return getUserData().schoolId == schoolId;
    }
    
    function isSameESA(esaId) {
      return getUserData().esaId == esaId;
    }
    
    function canAccessSchool(schoolId) {
      return isMinistryAdmin() || 
             (isESAAdmin() && get(/databases/$(database)/documents/organizations/$(schoolId)).data.esaId == getUserData().esaId) ||
             (isSchoolAdmin() && isSameSchool(schoolId));
    }
    
    // ==================== Core Collections ====================
    
    // Users collection (ENHANCED with hierarchy)
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwner(userId) || 
        isAnyAdmin() ||
        isTeacher() ||  // Teachers can read all users for dashboard
        isParent()  // Parents can read users to link with students
      );
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAnyAdmin());
      allow delete: if false; // No deletion allowed
    }
    
    // Organizations collection (NEW)
    // Allow reading ESAs and schools for profile setup (even without role)
    match /organizations/{orgId} {
      allow read: if isSignedIn(); // Anyone logged in can read (for profile setup)
      allow create: if isMinistryAdmin() || isESAAdmin();
      allow update: if isMinistryAdmin() || 
                      (isESAAdmin() && resource.data.esaId == getUserData().esaId) ||
                      (isSchoolAdmin() && resource.data.id == getUserData().schoolId);
      allow delete: if isMinistryAdmin();
    }
    
    // Classrooms collection (NEW)
    match /classrooms/{classroomId} {
      allow read: if isSignedIn() && (
        canAccessSchool(resource.data.schoolId) ||
        (isTeacher() && getUserData().uid in resource.data.teacherIds) ||
        (isStudent() && request.auth.uid in resource.data.studentIds)
      );
      allow create: if isSchoolAdmin() || isTeacher();
      allow update: if isSchoolAdmin() || 
                      (isTeacher() && getUserData().uid in resource.data.teacherIds);
      allow delete: if isSchoolAdmin();
    }
    
    // Master Curriculums collection (NEW)
    match /master_curriculums/{curriculumId} {
      allow read: if isSignedIn(); // ทุกคนอ่านได้
      allow create: if isMinistryAdmin(); // เฉพาะกระทรวงสร้างได้
      allow update: if isMinistryAdmin();
      allow delete: if isMinistryAdmin();
    }
    
    // Educational Standards collection (NEW)
    match /educational_standards/{standardId} {
      allow read: if isSignedIn(); // ทุกคนอ่านได้
      allow create: if isMinistryAdmin();
      allow update: if isMinistryAdmin();
      allow delete: if isMinistryAdmin();
    }
    
    // Student Portfolios collection (NEW)
    match /student_portfolios/{portfolioId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId) ||
        canAccessSchool(resource.data.schoolId)
      );
      allow create: if isSignedIn(); // Auto-created by system
      allow update: if isSignedIn(); // Auto-updated by system
      allow delete: if false; // Keep forever
    }
    
    // National Analytics collection (NEW)
    match /national_analytics/{analyticsId} {
      allow read: if isMinistryAdmin() || isESAAdmin();
      allow create: if isSignedIn(); // Cloud Functions create
      allow update: if isSignedIn(); // Cloud Functions update
      allow delete: if isMinistryAdmin();
    }
    
    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher() || isParent());
      allow create: if isSignedIn() && isStudent();
      allow update: if isSignedIn() && 
                      (isOwner(resource.data.studentId) || isTeacher());
      allow delete: if false;
    }
    
    // Messages collection
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
    
    // Assessments collection
    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher() || isParent());
      allow create: if isSignedIn(); // Cloud Functions create these
      allow update: if isTeacher();
      allow delete: if false;
    }
    
    // Reports collection
    match /reports/{reportId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }
    
    // Courses collection (ENHANCED with school context)
    match /courses/{courseId} {
      allow read: if isSignedIn(); // ให้ทุกคนที่ login แล้วอ่านได้ (จะ filter ที่ client)
      allow create: if isTeacher();
      allow update: if isTeacher() && isOwner(resource.data.teacherId);
      allow delete: if isTeacher() && isOwner(resource.data.teacherId);
    }
    
    // Student Progress collection
    match /studentProgress/{progressId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher() || isParent());
      allow create: if isSignedIn(); // Cloud Functions สร้าง
      allow update: if isSignedIn(); // Cloud Functions อัปเดต
      allow delete: if false; // ไม่อนุญาตให้ลบ
    }
    
    // Questions collection (ENHANCED with sharing scope)
    match /questions/{questionId} {
      allow read: if isSignedIn(); // ให้ทุกคนที่ login แล้วอ่านได้ (จะ filter ที่ client)
      allow create: if isTeacher();
      // 🔒 SECURITY FIX: นักเรียนแก้ได้เฉพาะ usageCount เท่านั้น, ครูแก้ได้ทุกอย่าง
      allow update: if isTeacher() || 
                      (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']));
      allow delete: if isTeacher() && isOwner(resource.data.teacherId);
    }
    
    // Class Reports collection (NEW - for analytics dashboard)
    // 🔒 SECURITY FIX: ใช้ Admin SDK จาก Cloud Functions เท่านั้น
    match /classReports/{reportId} {
      allow read: if isTeacher(); // เฉพาะครูอ่านได้
      allow create: if isTeacher(); // เฉพาะครูหรือ Cloud Functions (via Admin SDK)
      allow update: if isTeacher(); // เฉพาะครูหรือ Cloud Functions
      allow delete: if isTeacher(); // เฉพาะครูลบได้
    }
    
    // Learning Paths collection (ADAPTIVE LEARNING)
    // 🔒 SECURITY FIX: จำกัดการ update เฉพาะ owner หรือ teacher
    match /learningPaths/{pathId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn() && (isOwner(request.resource.data.studentId) || isTeacher());
      allow update: if isSignedIn() && (isOwner(resource.data.studentId) || isTeacher());
      allow delete: if isTeacher();
    }
    
    // Student Goals collection (GOAL SETTING)
    match /studentGoals/{goalId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn() && isStudent();
      allow update: if isSignedIn() && isOwner(resource.data.studentId);
      allow delete: if isSignedIn() && isOwner(resource.data.studentId);
    }
    
    // Micro Lessons collection (CONTENT FOR ADAPTIVE PATHS)
    match /microLessons/{lessonId} {
      allow read: if isSignedIn(); // ทุกคนอ่านได้
      allow create: if isTeacher(); // เฉพาะครูสร้างได้
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }
    
    // 🆕 Lesson Completions collection (TRACK STUDENT LESSON PROGRESS)
    match /lessonCompletions/{completionId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn() && isStudent(); // Students mark lessons complete
      allow update: if isSignedIn() && isOwner(resource.data.studentId); // Update rating
      allow delete: if false; // Keep completion history
    }
    
    // 🆕 Recommendations collection (PERSONALIZED CONTENT RECOMMENDATIONS)
    match /recommendations/{recommendationId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn(); // Cloud Functions generate recommendations
      allow update: if isSignedIn() && isOwner(resource.data.studentId); // Mark as dismissed
      allow delete: if isSignedIn() && isOwner(resource.data.studentId); // Delete old recommendations
    }
    
    // 🆕 Review Schedule collection (SPACED REPETITION SYSTEM)
    match /reviewSchedule/{scheduleId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn(); // Cloud Functions schedule reviews
      allow update: if isSignedIn() && isOwner(resource.data.studentId); // Mark as completed
      allow delete: if isTeacher(); // Teachers can clear old schedules
    }
    
    // Progress History collection (TRACK IMPROVEMENTS OVER TIME)
    match /progressHistory/{historyId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn(); // Cloud Functions record history
      allow update: if false; // Immutable once created
      allow delete: if false; // Keep history forever
    }
    
    // Risk Predictions collection (PHASE 3: PREDICTIVE ANALYTICS)
    match /riskPredictions/{predictionId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn(); // Cloud Functions generate predictions
      allow update: if false; // Immutable once created
      allow delete: if isTeacher(); // Teachers can delete old predictions
    }
    
    // Skill Gap Analyses collection (PHASE 3: SKILL GAP ANALYSIS)
    match /skillGapAnalyses/{analysisId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher());
      allow create: if isSignedIn(); // Cloud Functions generate analyses
      allow update: if false; // Immutable once created
      allow delete: if isTeacher();
    }
    
    // Intervention Plans collection (PHASE 3: AI INTERVENTIONS)
    match /interventionPlans/{planId} {
      allow read: if isTeacher(); // Only teachers can see intervention plans
      allow create: if isSignedIn(); // Cloud Functions generate plans
      allow update: if isTeacher(); // Teachers can mark as implemented
      allow delete: if isTeacher();
    }
    
    // Parent Reports collection (PHASE 3: PARENT REPORTS)
    match /parentReports/{reportId} {
      allow read: if isSignedIn() &&
                    (isOwner(resource.data.studentId) || isTeacher() || isParent());
      allow create: if isSignedIn(); // Cloud Functions generate reports
      allow update: if isTeacher(); // Teachers can add comments
      allow delete: if isTeacher();
    }
    
    // Notifications collection (PHASE 3: SMART NOTIFICATIONS)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
                    (isOwner(resource.data.userId) || isTeacher());
      allow create: if isSignedIn(); // System generates notifications
      allow update: if isSignedIn() && isOwner(resource.data.userId); // Mark as read
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // 🆕 Anti-Cheat Logs collection (MONITOR SUSPICIOUS ACTIVITY)
    match /antiCheatLogs/{logId} {
      allow read: if isTeacher() || isAnyAdmin(); // Only teachers and admins can view
      allow create: if isSignedIn(); // Cloud Functions log suspicious activity
      allow update: if isTeacher(); // Teachers can review and mark as resolved
      allow delete: if isAnyAdmin(); // Only admins can delete logs
    }
    
    // 🆕 Lesson Plans collection (AI-GENERATED TEACHING PLANS)
    match /lessonPlans/{planId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.teacherId) || isAnyAdmin() ||
                     (resource.data.status == 'published' && isTeacher()));
      allow create: if isTeacher(); // Only teachers can create lesson plans
      allow update: if isTeacher() && isOwner(resource.data.teacherId); // Only owner can update
      allow delete: if isTeacher() && isOwner(resource.data.teacherId); // Only owner can delete
    }
    
    // 🆕 Course Structures collection (AI CURRICULUM DESIGNER)
    match /courseStructures/{structureId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.teacherId) || isAnyAdmin());
      allow create: if isTeacher(); // Only teachers can create
      allow update: if isTeacher() && isOwner(resource.data.teacherId); // Only owner can update
      allow delete: if isTeacher() && isOwner(resource.data.teacherId); // Only owner can delete
    }
    
    // 🆕 Learning Units collection (AI CURRICULUM DESIGNER - UNIT DETAILS)
    match /learningUnits/{unitId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.teacherId) || isAnyAdmin());
      allow create: if isTeacher(); // Only teachers can create
      allow update: if isTeacher() && isOwner(resource.data.teacherId); // Only owner can update
      allow delete: if isTeacher() && isOwner(resource.data.teacherId); // Only owner can delete
    }
    
    // 🆕 AI Usage Logs collection (TRACK AI FEATURE USAGE)
    match /aiUsageLogs/{logId} {
      allow read: if isAnyAdmin(); // Only admins can view usage logs
      allow create: if isSignedIn(); // Cloud Functions log AI usage
      allow update: if false; // Immutable
      allow delete: if isMinistryAdmin(); // Only ministry admin can delete
    }
    
    // 🆕 Audit Logs collection (SYSTEM AUDIT TRAIL)
    match /auditLogs/{logId} {
      allow read: if isAnyAdmin(); // Only admins can view audit logs
      allow create: if isSignedIn(); // Cloud Functions create audit logs
      allow update: if false; // Immutable
      allow delete: if false; // Never delete audit logs
    }
    
    // ==================== ELECTRONIC WORKSHEET SYSTEM ====================
    
    // 🆕 Electronic Worksheets collection (AI-GENERATED WORKSHEETS)
    match /eWorksheets/{worksheetId} {
      allow read: if isSignedIn(); // All authenticated users can read
      allow create: if isTeacher(); // Only teachers can create worksheets
      // Allow teachers full update, students can only update stats
      allow update: if isTeacher() || 
                      (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']));
      allow delete: if isTeacher(); // Teachers can delete their worksheets
    }
    
    // 🆕 Worksheet Submissions collection (STUDENT SUBMISSIONS)
    match /worksheetSubmissions/{submissionId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.studentId) || isTeacher() || isParent());
      // Allow any signed-in user to create, check studentId matches their uid
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn(); // System updates with assessment
      allow delete: if false; // Never delete submissions
    }
    
    // 🆕 Worksheet Drafts collection (STUDENT DRAFT ANSWERS)
    match /worksheetDrafts/{draftId} {
      allow read: if isSignedIn() && isOwner(resource.data.studentId);
      // Allow any signed-in user to create/update their own drafts
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }
    
    // 🆕 Learning Rooms collection (ACTIVITY ROOMS FOR COURSES)
    match /learningRooms/{roomId} {
      allow read: if isSignedIn(); // All authenticated users can view rooms
      allow create: if isTeacher(); // Only teachers can create rooms
      allow update: if isTeacher(); // Teachers can update their rooms
      allow delete: if isTeacher(); // Teachers can delete their rooms
    }
    
    // 🆕 Knowledge Sheets collection (AI-GENERATED KNOWLEDGE SHEETS)
    match /knowledgeSheets/{sheetId} {
      allow read: if isSignedIn(); // All authenticated users can read
      allow create: if isTeacher(); // Only teachers can create
      allow update: if isTeacher(); // Teachers can update their sheets
      allow delete: if isTeacher(); // Teachers can delete their sheets
    }
    
    // 🆕 Unit Knowledge Sheets collection (AI-GENERATED UNIT-LEVEL KNOWLEDGE SHEETS)
    match /unitKnowledgeSheets/{sheetId} {
      allow read: if isSignedIn(); // All authenticated users can read
      allow create: if isTeacher(); // Only teachers can create
      allow update: if isTeacher(); // Teachers can update their sheets
      allow delete: if isTeacher(); // Teachers can delete their sheets
    }
    
    // 🆕 User Presence collection (REAL-TIME ONLINE STATUS)
    match /userPresence/{odId} {
      // Teachers can read all presence data to see online students
      // Students can only read their own presence
      allow read: if isSignedIn() && (isOwner(odId) || isTeacher());
      // Users can create/update their own presence only
      allow create: if isSignedIn() && isOwner(odId);
      allow update: if isSignedIn() && isOwner(odId);
      // Users can delete their own presence (on disconnect)
      allow delete: if isSignedIn() && isOwner(odId);
    }
    
    // ==================== SLC/PLC COMMUNITY SYSTEM ====================
    
    // 🆕 Communities collection (SLC for students, PLC for teachers)
    match /communities/{communityId} {
      allow read: if isSignedIn(); // Anyone can browse communities
      allow create: if isSignedIn(); // Anyone can create a community
      allow update: if isSignedIn() && (
        isOwner(resource.data.creatorId) || 
        request.auth.uid in resource.data.moderatorIds ||
        isAnyAdmin()
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.creatorId) || isAnyAdmin()
      );
    }
    
    // 🆕 Community Members subcollection
    match /communities/{communityId}/members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(memberId); // Users add themselves
      allow update: if isSignedIn() && (
        isOwner(memberId) || 
        request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.moderatorIds
      );
      allow delete: if isSignedIn() && (
        isOwner(memberId) ||
        request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.moderatorIds
      );
    }
    
    // 🆕 Discussions collection (linked to content - assessments, worksheets, lessons)
    match /discussions/{discussionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.authorId) ||
        isTeacher() ||
        isAnyAdmin()
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.authorId) ||
        isTeacher() ||
        isAnyAdmin()
      );
    }
    
    // 🆕 Discussion Replies subcollection
    match /discussions/{discussionId}/replies/{replyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.authorId);
      allow delete: if isSignedIn() && (
        isOwner(resource.data.authorId) ||
        isTeacher() ||
        isAnyAdmin()
      );
    }
    
    // 🆕 Help Requests collection (LO-based help system)
    match /helpRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Anyone can request help
      allow update: if isSignedIn(); // Update when helped/resolved
      allow delete: if isSignedIn() && isOwner(resource.data.requesterId);
    }
    
    // 🆕 Help Offers subcollection
    match /helpRequests/{requestId}/offers/{offerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isOwner(get(/databases/$(database)/documents/helpRequests/$(requestId)).data.requesterId); // Can't offer help to yourself
      allow update: if isSignedIn() && (
        isOwner(resource.data.helperId) ||
        request.auth.uid == get(/databases/$(database)/documents/helpRequests/$(requestId)).data.requesterId
      );
      allow delete: if isSignedIn() && isOwner(resource.data.helperId);
    }
    
    // 🆕 Shared Content collection (curated best answers, study materials)
    match /sharedContent/{contentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Anyone can share
      allow update: if isSignedIn() && (
        isOwner(resource.data.sharerId) ||
        isTeacher() // Teachers can feature content
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.sharerId) ||
        isTeacher()
      );
    }
    
    // 🆕 Study Sessions collection (scheduled study/tutoring sessions)
    match /studySessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.hostId) ||
        request.auth.uid in resource.data.participantIds
      );
      allow delete: if isSignedIn() && isOwner(resource.data.hostId);
    }
    
    // 🆕 Study Session Participants subcollection
    match /studySessions/{sessionId}/participants/{participantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(participantId);
      allow update: if isSignedIn() && isOwner(participantId);
      allow delete: if isSignedIn() && (
        isOwner(participantId) ||
        request.auth.uid == get(/databases/$(database)/documents/studySessions/$(sessionId)).data.hostId
      );
    }
    
    // 🆕 Mentor Relationships collection (peer mentoring)
    match /mentorRelationships/{relationId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.mentorId) ||
        isOwner(resource.data.menteeId) ||
        isTeacher()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.mentorId) ||
        isOwner(resource.data.menteeId)
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.mentorId) ||
        isOwner(resource.data.menteeId)
      );
    }
    
    // 🆕 Resource Library collection (shared resources - files, links, notes)
    match /resourceLibrary/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.uploaderId) ||
        isTeacher()
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.uploaderId) ||
        isTeacher()
      );
    }
    
    // 🆕 Community Notifications collection
    match /communityNotifications/{notifId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn(); // System creates notifications
      allow update: if isSignedIn() && isOwner(resource.data.userId); // Mark as read
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // 🆕 Teaching Strategies collection (PLC - teacher knowledge sharing)
    match /teachingStrategies/{strategyId} {
      allow read: if isTeacher() || isAnyAdmin(); // Only teachers can view
      allow create: if isTeacher();
      allow update: if isTeacher() && (
        isOwner(resource.data.authorId) ||
        isAnyAdmin()
      );
      allow delete: if isTeacher() && (
        isOwner(resource.data.authorId) ||
        isAnyAdmin()
      );
    }
    
    // 🆕 Strategy Comments subcollection
    match /teachingStrategies/{strategyId}/comments/{commentId} {
      allow read: if isTeacher() || isAnyAdmin();
      allow create: if isTeacher();
      allow update: if isTeacher() && isOwner(resource.data.authorId);
      allow delete: if isTeacher() && (
        isOwner(resource.data.authorId) ||
        isAnyAdmin()
      );
    }
    
    // 🆕 Lesson Plan Shares collection (PLC - shared lesson plans with ratings)
    match /lessonPlanShares/{shareId} {
      allow read: if isTeacher() || isAnyAdmin();
      allow create: if isTeacher();
      allow update: if isTeacher(); // Update ratings, downloads
      allow delete: if isTeacher() && isOwner(resource.data.sharerId);
    }
    
    // 🆕 Question Bank Collaborations collection (PLC - collaborative question creation)
    match /questionCollabs/{collabId} {
      allow read: if isTeacher() || isAnyAdmin();
      allow create: if isTeacher();
      allow update: if isTeacher() && (
        isOwner(resource.data.initiatorId) ||
        request.auth.uid in resource.data.collaboratorIds
      );
      allow delete: if isTeacher() && isOwner(resource.data.initiatorId);
    }
    
    // 🆕 Collab Questions subcollection
    match /questionCollabs/{collabId}/questions/{questionId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }
    
    // 🆕 Analytics Insights collection (PLC - shared analytics findings)
    match /analyticsInsights/{insightId} {
      allow read: if isTeacher() || isAnyAdmin();
      allow create: if isTeacher();
      allow update: if isTeacher() && isOwner(resource.data.authorId);
      allow delete: if isTeacher() && (
        isOwner(resource.data.authorId) ||
        isAnyAdmin()
      );
    }
    
    // 🆕 User Follows collection (follow relationships)
    match /userFollows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }
    
    // 🆕 Activity Feed collection (aggregated activities)
    match /activityFeed/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // System creates activities
      allow update: if false; // Immutable
      allow delete: if isAnyAdmin();
    }
    
    // ==================== SOCIAL LEARNING FEED ====================
    
    // 🆕 Posts collection (Social feed posts - achievements, discussions, resources)
    match /posts/{postId} {
      allow read: if isSignedIn(); // All authenticated users can read posts
      allow create: if isSignedIn(); // Any user can create posts
      allow update: if isSignedIn() && (
        isOwner(resource.data.authorId) ||
        isTeacher() ||
        isAnyAdmin()
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.authorId) ||
        isTeacher() ||
        isAnyAdmin()
      );
    }
    
    // 🆕 Post Comments subcollection
    match /posts/{postId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.authorId);
      allow delete: if isSignedIn() && (
        isOwner(resource.data.authorId) ||
        isTeacher() ||
        isAnyAdmin()
      );
    }
    
    // 🆕 Post Reactions subcollection (likes, celebrates, etc.)
    match /posts/{postId}/reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // 🆕 Comments collection (TOP-LEVEL - linked to posts via postId)
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.authorId);
      allow delete: if isSignedIn() && (
        isOwner(resource.data.authorId) ||
        isTeacher() ||
        isAnyAdmin()
      );
    }
    
    // 🆕 Reactions collection (TOP-LEVEL - linked to posts via postId)
    match /reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.userId);
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
    
    // 🆕 Groups collection (Study groups, interest groups)
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(resource.data.creatorId) ||
        request.auth.uid in resource.data.adminIds ||
        isTeacher()
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.creatorId) ||
        isTeacher() ||
        isAnyAdmin()
      );
    }
    
    // 🆕 Group Members subcollection
    match /groups/{groupId}/members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(memberId);
      allow update: if isSignedIn() && (
        isOwner(memberId) ||
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds
      );
      allow delete: if isSignedIn() && (
        isOwner(memberId) ||
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds
      );
    }
    
    // 🆕 Parent Notifications collection (Weekly reports & alerts to parents)
    match /parentNotifications/{notifId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.parentId) ||
        isOwner(resource.data.studentId) ||
        isTeacher() ||
        isParent()
      );
      allow create: if isSignedIn(); // System creates notifications
      allow update: if isSignedIn() && (
        isOwner(resource.data.parentId) ||
        isParent()
      ); // Mark as read
      allow delete: if isTeacher() || isAnyAdmin();
    }
  }
}
